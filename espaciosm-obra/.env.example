# Copia este archivo como .env y llena los valores.
# Se obtienen en Supabase: Project Settings > API.
#
# IMPORTANTE: la llave "anon" es pública por diseño; puede viajar en el
# navegador. La protección real de los datos son las políticas RLS (0002).
# NUNCA pongas aquí la llave "service_role": esa salta RLS por completo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-llave-anon...
